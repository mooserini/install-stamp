+def _resolve_redirect_uri() -> str:
+    """Redirect URI for the currently stored client secret.
+
+    A stored *web* client secret declares its registered redirect URIs in
+    the JSON itself; the first entry is authoritative and must be used
+    byte-identically at authorize time and at exchange time. An
+    *installed* (desktop) client declares none, so the loopback default
+    stands unchanged. An explicit GOOGLE_WORKSPACE_REDIRECT_URI
+    environment override wins over both.
+    """
+    override = os.environ.get("GOOGLE_WORKSPACE_REDIRECT_URI", "").strip()
+    if override:
+        return override
+    try:
+        data = json.loads(CLIENT_SECRET_PATH.read_text(encoding="utf-8"))
+        uris = (data.get("web") or {}).get("redirect_uris") or []
+        if uris:
+            return str(uris[0])
+    except Exception:
+        pass
+    return REDIRECT_URI
+
